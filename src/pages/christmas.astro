---
// Unlisted Christmas list. Nothing on the site links here, the sitemap in
// astro.config.mjs skips this path, and Layout's noindex keeps it out of
// search. Items come from src/assets/data/christmas.ts.
import Layout from '../layouts/Layout.astro';
import { christmasItems, CHRISTMAS_YEAR } from '../assets/data/christmas';
import '../styles/global.scss';
---

<Layout title={`Christmas list ${CHRISTMAS_YEAR}`} description="Jesse's Christmas list" noindex>
  <main class="xmas">
    <h1 class="xmas-title">Christmas list {CHRISTMAS_YEAR}</h1>
    <ul class="xmas-list">
      {christmasItems.map((item) => (
        <li>
          <a class="xmas-item" href={item.url} target="_blank" rel="noopener noreferrer">
            <span class="xmas-image"><img src={item.image} alt="" loading="lazy" referrerpolicy="no-referrer" /></span>
            <span class="xmas-body">
              <span class="xmas-name">{item.name}</span>
              {item.note && <span class="xmas-note">{item.note}</span>}
              <span class="xmas-meta">{item.price} at {item.store}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style lang="scss">
  @use '../styles/vars' as *;

  .xmas {
    max-width: 560px;
    margin: 0 auto;
    padding: $gap-2xl $gap-regular $gap-xl;
    @media (max-width: $breakpoint-sm) {
      padding-top: $gap-xl;
    }
  }
  .xmas-title {
    font-size: $fs-large;
    font-weight: 500;
    margin-bottom: $gap-large;
  }
  .xmas-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: $gap-small;
  }
  .xmas-item {
    display: flex;
    align-items: center;
    gap: $gap-regular;
    width: 100%;
    padding: $gap-small;
    border: 1px solid $border-color;
    border-radius: 12px;
    background: $secondary-background;
    color: $primary-text;
    text-decoration: none;
    transition: border-color 0.15s;
    &:hover,
    &:focus-visible {
      border-color: $secondary-border-color;
    }
  }
  .xmas-image {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: 8px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 6px;
    }
  }
  .xmas-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .xmas-name {
    font-size: $fs-regular;
    font-weight: 500;
    line-height: 1.3;
  }
  .xmas-note {
    font-size: $fs-xs;
    color: $secondary-text;
  }
  .xmas-meta {
    font-size: $fs-xs;
    color: $secondary-text;
  }
</style>
